# ===========================================
# DATABASE
# ===========================================
# PostgreSQL connection string
# For Docker Compose: postgresql://postgres:postgres@localhost:5433/dropshipping
# Note: Docker Compose maps host port 5433 to container port 5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dropshipping"

# Seed account passwords (npm run db:seed). Leave unset for local development:
# the seed generates a random password per role and prints it once. A non-local
# DATABASE_URL refuses to seed unless these are set explicitly — the seed will
# not invent a password for a database you cannot easily rotate.
# SEED_ADMIN_PASSWORD=""
# SEED_CUSTOMER_PASSWORD=""

# ===========================================
# AUTHENTICATION (NextAuth.js)
# ===========================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl"
NEXTAUTH_URL="http://localhost:3000"
# Set to "true" in CI or when behind reverse proxy (required for E2E tests in CI)
# AUTH_TRUST_HOST="false"

# OAuth Providers (optional — NOT YET IMPLEMENTED)
# Google OAuth (placeholder for future implementation)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ===========================================
# STRIPE PAYMENTS
# ===========================================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."

# ===========================================
# EMAIL (Resend)
# ===========================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=""
# Email address for sending emails
EMAIL_FROM="noreply@yourdomain.com"
# Feedback form recipient (TASK-058).
FEEDBACK_EMAIL=""

# Nova Poshta (G25 checkout city/branch picker). OPTIONAL: the directory
# methods answer keyless. Server-side only — never NEXT_PUBLIC_. An INVALID or
# EXPIRED key fails every call (the checkout then falls back to free-text
# fields; cached queries keep answering, so only new ones show it). Prefer an
# unlimited-validity key and keep `npm run smoke` green — its uncached NP row
# is the detector.
NOVAPOSHTA_API_KEY=""

# ===========================================
# FILE STORAGE (S3-compatible: AWS S3 or Cloudflare R2)
# ===========================================
# ONE contract for both providers (G16). For Cloudflare R2, put the R2 API
# token's key pair in the AWS_* slots, the bucket name in AWS_S3_BUCKET, and
# set S3_ENDPOINT to the account endpoint — there are no R2_* variables.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Leave unset for R2 (the client uses "auto" when S3_ENDPOINT is set).
AWS_REGION=""
AWS_S3_BUCKET="your-bucket-name"
# R2 only: https://<ACCOUNT_ID>.r2.cloudflarestorage.com. Unset = real AWS S3.
S3_ENDPOINT=""
# Public base URL that product image URLs are built from. R2: the bucket's
# r2.dev URL (rate-limited, interim) until the custom domain lands — then
# https://img.<domain>. AWS: the CloudFront distribution.
AWS_CLOUDFRONT_URL=""

# ===========================================
# REDIS (for job queues and caching)
# ===========================================
# For Docker Compose: redis://localhost:6380
# Note: Docker Compose maps host port 6380 to container port 6379
REDIS_URL="redis://localhost:6380"

# ===========================================
# APP CONFIG
# ===========================================
# Base URL for the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Store name displayed in UI. Optional — leaving this unset falls back to the
# Mirox Shop brand name (see src/content/brand.ts), so only override it if a
# specific deployment needs a different display name.
NEXT_PUBLIC_STORE_NAME="Mirox Shop"

# ===========================================
# OPTIONAL: SEARCH (Meilisearch — NOT YET IMPLEMENTED)
# ===========================================
# Placeholder for future search indexing implementation
# MEILISEARCH_HOST="http://localhost:7700"
# MEILISEARCH_API_KEY=""

# ===========================================
# ANALYTICS (Google Tag Manager)
# ===========================================
# GTM container ID (e.g., GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=""

# ===========================================
# OPTIONAL: MONITORING (Sentry — NOT YET IMPLEMENTED)
# ===========================================
# Sentry SDK is not installed. These are placeholders for future implementation.
# Get from: https://sentry.io/settings/projects/
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# ===========================================
# NODE_ENV
# ===========================================
# Do NOT set NODE_ENV here (or in .env). Next.js manages it internally per
# command — "development" for `next dev`, "production" for `next build` /
# `next start` — and loads this same .env file for all three. A
# NODE_ENV="development" line here silently leaks into `next build`'s CSS
# pipeline (Tailwind v4 + Lightning CSS via @tailwindcss/postcss) and
# corrupts every responsive (sm:/md:/lg:/xl:) utility's compiled output —
# their declarations get merged into an unrelated selector instead of being
# minified correctly, so the whole site collapses to its single-column
# mobile layout at every viewport width in any LOCALLY built production
# bundle. Vercel deployments are unaffected (the platform sets
# NODE_ENV=production before this file is loaded), which is why this was
# invisible until someone ran and screenshotted a local `next build`. Next.js
# also warns about this directly at build time: "You are using a
# non-standard NODE_ENV value in your environment." Root-caused 2026-07-28
# (TASK-057 Task 12 fix loop) — do not re-add this line.
